<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest (App Store required-reason APIs, enforced since May 2024).
  Without this file the upload is accepted and then bounced by App Store Connect
  with ITMS-91053, so the build never reaches TestFlight.

  Declare only what the code actually does. Audited at the time of writing:
    - UserDefaults: App/DI.swift, App/AppModel.swift, App/Design/PenPresence.swift
    - File timestamp / disk space / boot time / active keyboard APIs: NONE.
      App/Page/PageArchive.swift uses FileManager.urls(for:in:) and
      createDirectory, neither of which is on Apple's required-reason list.
      Do not add NSPrivacyAccessedAPICategoryFileTimestamp speculatively —
      declaring a reason the binary cannot justify invites review questions.
  Re-audit this file whenever a package gains a new Foundation dependency.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: read/write only this app's own container. No App
				     Group, no shared suite — UserDefaults.standard throughout. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- Page snapshots. InkNet/ProxyClient.swift uploads a rasterized
			     crop of the user's handwriting to the proxy, which forwards it
			     to the model provider. That is off-device transmission, so it
			     is collection even though nothing is retained for advertising. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<!-- Linked (audit C-5): a reported page is stored under the
			     device identity for guideline 1.2 triage, and every exchange
			     is logged against it. -->
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- The device identity: a server-minted opaque id proved by App
			     Attest (App/Security/AppAttestIdentity.swift), carried as a
			     session token in the x-ink-user header, with the legacy
			     Keychain token as the fallback for hardware that cannot
			     attest.

			     Linked = TRUE (audit C-5). It is tied to no NAME, but the
			     proxy stores the wallet, the credit ledger, the daily
			     quotas, the proved subscription tier and any filed report
			     under exactly this id — so the other collected data IS
			     associated with it, which is what Apple's "linked" question
			     asks. Declaring it unlinked understated the collection. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Purchase history (audit C-5). App/Money/PurchaseService.swift
			     forwards the StoreKit JWS of every vial purchase and every
			     subscription to the proxy (/v1/credits/grant,
			     /v1/entitlement), which records product, transaction id and
			     tier against the device identity. Linked for the same reason
			     as the id above. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
