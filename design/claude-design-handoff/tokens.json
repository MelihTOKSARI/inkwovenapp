{
  "name": "Inkwoven — Candlelit Stationery",
  "platform": "SwiftUI (iPad-first, iPhone companion)",
  "color": {
    "parchment": "#F4EAD5",
    "parchmentDeep": "#E7D7B4",
    "ink": "#2E2418",
    "inkFaded": "#6B5A43",
    "room": "#17110B",
    "roomRaised": "#241B12",
    "candle": "#C9962E",
    "candleBright": "#E8B84B",
    "wax": "#7A2E2B",
    "successHerb": "#4A5D3A",
    "dangerEmber": "#8C3B2E",
    "books": {
      "storyteller": "#3E4E6B",
      "artist": "#9C4A3C",
      "gameMaster": "#4A5D3A",
      "oracle": "#5B4370",
      "keeper": "#6E3B34",
      "correspondent": "#8A6B4F",
      "tutor": "#46607C",
      "parlor": "#7C4E68"
    }
  },
  "typography": {
    "display": { "family": "Cormorant Garamond", "weight": 600, "sizes": [34, 28] },
    "body": { "family": "EB Garamond", "weight": 400, "size": 17, "dynamicType": true },
    "caption": { "family": "EB Garamond", "weight": 500, "size": 13, "case": "smallCaps", "letterSpacing": 0.08 },
    "inkReply": { "family": "per-Book script (8 hands)", "size": [20, 24], "userScalable": true }
  },
  "spacing": { "grid": 4, "pageMargin": 24, "cardPadding": 16 },
  "radius": { "paper": 2, "card": 6, "seal": 999 },
  "elevation": { "style": "candle-glow", "shadow": "0 0 24px rgba(201,150,46,0.18)" },
  "motion": {
    "absorb": { "duration": 1500, "easing": "cubic-bezier(0.55, 0.06, 0.68, 0.19)", "blur": 7, "sink": 7 },
    "surfacing": { "note": "the absorb reversed — same duration/blur/distance, curve mirrored; the reply appears WHOLE, never streamed" },
    "develop": { "duration": 2200, "staged": ["edges", "midtones", "detail"] },
    "pageTurn": 450,
    "sealPress": 200,
    "reduceMotionFallback": { "fold": 0.35, "floor": 90, "note": "every time folds; nothing skips" }
  },
  "accessibility": { "contrast": "WCAG AA", "hitTarget": 44, "colorNeverOnlySignal": true },
  "components": [
    "BookSpine", "BookCover", "Page", "InkReply", "DevelopFrame", "WaxSealButton",
    "RibbonTab", "VialChip", "MarginNote", "CandleSheet", "QuietBanner", "CrisisCard"
  ]
}
